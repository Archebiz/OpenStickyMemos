<UserControl x:Class="OpenStickyMemos.Desktop.Views.NoteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             MinWidth="140" MinHeight="100">

    <UserControl.Resources>
        <!-- 🎯 Toolbar button style -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#00000015"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Save button style -->
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4A90D9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="5"
                                Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="NoteBorder" CornerRadius="16"
            BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
            Padding="12,8,12,6" RenderTransformOrigin="0.5,0.5">
        <!-- Glass background: semi-transparent gradient of the note color -->
        <Border.Background>
            <LinearGradientBrush x:Name="NoteBgGradient" StartPoint="0,0" EndPoint="0.7,1">
                <GradientStop Offset="0" Color="#F0FFE066"/>
                <GradientStop Offset="1" Color="#C0FFE066"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6"
                              Opacity="0.18" Color="#000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Glass highlight overlay -->
            <Border Grid.RowSpan="3" CornerRadius="14" Margin="2"
                    Background="{StaticResource GlassNoteOverlay}"
                    IsHitTestVisible="False"/>

            <!-- Overlay de estado pendiente de aprobación (miembro solicitó archivar/eliminar) -->
            <Border x:Name="PendingOverlay" Grid.RowSpan="3"
                    CornerRadius="14" Margin="2"
                    Background="#E6FFFFFF"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⏳" FontSize="18" TextAlignment="Center"/>
                    <TextBlock x:Name="PendingText" Text="Pendiente de aprobación"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="#8A6D3B" TextAlignment="Center"
                               Margin="8,4,8,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Toolbar: glass style (appears on hover) -->
            <Border x:Name="ToolbarOverlay" Grid.Row="0"
                    Background="{StaticResource GlassToolbarBg}"
                    CornerRadius="10" Padding="5,3"
                    Margin="-2,-2,-2,0"
                    Opacity="0.0"
                    BorderBrush="#30FFFFFF" BorderThickness="0.5">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="BringFrontButton" Content="⬆"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Traer al frente"
                            Click="BringFrontButton_Click"/>
                    <Button x:Name="SendBackButton" Content="⬇"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Enviar al fondo"
                            Click="SendBackButton_Click"/>
                    <Button x:Name="PinButton" Content="📌"
                            Style="{StaticResource ToolbarButtonStyle}"
                            FontSize="10" Width="22" Height="22"
                            ToolTip="Fijar nota"
                            Click="PinButton_Click"/>
                    <Button x:Name="ColorButton" Content="🎨"
                            Style="{StaticResource ToolbarButtonStyle}"
                            FontSize="10" Width="22" Height="22"
                            ToolTip="Cambiar color"
                            Click="ColorButton_Click"/>
                    <Button x:Name="ArchiveButton" Content="🗄️"
                            Style="{StaticResource ToolbarButtonStyle}"
                            FontSize="10" Width="22" Height="22"
                            ToolTip="Archivar nota"
                            Click="ArchiveButton_Click"/>
                    <Button x:Name="DeleteButton" Content="🗑"
                            Style="{StaticResource ToolbarButtonStyle}"
                            FontSize="10" Width="22" Height="22"
                            ToolTip="Eliminar nota"
                            Click="DeleteButton_Click"/>
                </StackPanel>
            </Border>

            <!-- === VIEW MODE (doble click para editar) === -->
            <Grid Grid.Row="1" x:Name="ViewPanel" Visibility="Visible"
                  Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Título con indicadores -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock x:Name="PinIndicator" Text="📌" FontSize="9"
                               Visibility="Collapsed" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ReminderBadge" Text="🔔" FontSize="9"
                               Visibility="Collapsed" Margin="0,0,4,0" VerticalAlignment="Center"
                               ToolTip="Recordatorio programado"/>
                    <TextBlock x:Name="ViewTitle" Grid.Row="0"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#333" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <RichTextBox x:Name="ViewRichContent" Grid.Row="1"
                           IsReadOnly="True"
                           Focusable="False"
                           IsHitTestVisible="False"
                           BorderThickness="0"
                           Background="Transparent"
                           Padding="0,2,0,4"
                           VerticalScrollBarVisibility="Hidden"
                           HorizontalScrollBarVisibility="Disabled"
                           Visibility="Collapsed"/>

                <!-- Lista de tareas (modo checklist) -->
                <ScrollViewer x:Name="TaskListScroll" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <StackPanel x:Name="TaskListPanel" Margin="0,2,0,4"/>
                </ScrollViewer>

                <!-- Placeholder for empty notes -->
                <TextBlock x:Name="EmptyPlaceholder" Grid.Row="2"
                           Text="Doble click para editar"
                           FontSize="11" FontStyle="Italic"
                           Foreground="#A0A0A0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="0,0,0,4"/>

                <!-- Etiquetas (chips) -->
                <WrapPanel x:Name="TagChipsPanel" Grid.Row="3"
                           Visibility="Collapsed" Margin="0,2,0,0"/>

                <!-- Author info -->
                <StackPanel x:Name="AuthorPanel" Grid.Row="4" Orientation="Horizontal"
                            Visibility="Collapsed" Margin="0,2,0,0">
                    <Border Background="#00000015" CornerRadius="8" Padding="5,1,5,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✍" FontSize="8" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AuthorText" FontSize="9" Foreground="#888"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- === EDIT MODE === -->
            <Grid Grid.Row="1" x:Name="EditPanel" Visibility="Collapsed"
                  Margin="0,2,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="#D0D0D0" BorderThickness="1"
                        CornerRadius="5" Margin="0,0,0,4" Background="#FFFFFFB0">
                    <TextBox x:Name="TitleBox"
                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13" FontWeight="SemiBold"
                             Background="Transparent" BorderThickness="0"
                             Padding="6,4" TextWrapping="Wrap"
                             AcceptsReturn="False" Foreground="#333"
                             LostFocus="TitleBox_LostFocus"/>
                </Border>
                <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1"
                        CornerRadius="5" Background="#FFFFFFB0" MinHeight="50">
                    <StackPanel>
                        <!-- Barra de formato -->
                        <StackPanel Orientation="Horizontal" Margin="4,3,4,0">
                            <Button Content="B" Style="{StaticResource ToolbarButtonStyle}"
                                    FontWeight="Bold" FontSize="11"
                                    ToolTip="Negrita" Click="BoldButton_Click"/>
                            <Button Content="I" Style="{StaticResource ToolbarButtonStyle}"
                                    FontStyle="Italic" FontSize="11"
                                    ToolTip="Cursiva" Click="ItalicButton_Click"/>
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    FontSize="11"
                                    ToolTip="Subrayado" Click="UnderlineButton_Click">
                                <TextBlock Text="U" TextDecorations="Underline"/>
                            </Button>
                            <Button Content="•" Style="{StaticResource ToolbarButtonStyle}"
                                    FontSize="13"
                                    ToolTip="Lista con viñetas" Click="BulletButton_Click"/>
                            <Button x:Name="EmojiButton" Content="😊"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    FontSize="11"
                                    ToolTip="Emoji" Click="EmojiButton_Click"/>
                            <Border Width="1" Height="16" Background="#D0D0D0" Margin="4,0"/>
                            <Button x:Name="TaskModeButton" Content="☑"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    FontSize="12"
                                    ToolTip="Lista de tareas (modo checklist)"
                                    Click="TaskModeButton_Click"/>
                            <Button x:Name="TagsButton" Content="🏷"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    FontSize="11"
                                    ToolTip="Etiquetas"
                                    Click="TagsButton_Click"/>
                            <Button x:Name="ReminderButton" Content="🔔"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    FontSize="11"
                                    ToolTip="Recordatorio"
                                    Click="ReminderButton_Click"/>
                        </StackPanel>
                        <RichTextBox x:Name="RichEditor"
                                     FontSize="12" Background="Transparent"
                                     BorderThickness="0"
                                     Padding="4,4"
                                     VerticalScrollBarVisibility="Auto"
                                     AcceptsTab="True"
                                     MinHeight="40"
                                     LostFocus="RichEditor_LostFocus"/>

                        <!-- Editor de lista de tareas (modo checklist) -->
                        <ScrollViewer x:Name="TaskEditorScroll" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" MaxHeight="180">
                            <StackPanel x:Name="TaskEditorItems" Margin="4,2,4,2"/>
                        </ScrollViewer>
                        <Button x:Name="AddTaskButton" Content="＋ Agregar tarea"
                                Visibility="Collapsed"
                                HorizontalAlignment="Left"
                                Margin="6,2,6,4"
                                FontSize="11"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#4A90D9" Cursor="Hand"
                                Click="AddTaskButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- Popup de etiquetas -->
                <Popup x:Name="TagsPopup"
                       PlacementTarget="{Binding ElementName=TagsButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Background="White" CornerRadius="8"
                            BorderBrush="#DDD" BorderThickness="1" Padding="10">
                        <StackPanel Width="200">
                            <TextBlock Text="Etiquetas (separadas por coma)" FontSize="11"
                                       Foreground="#666" Margin="0,0,0,4"/>
                            <TextBox x:Name="TagsInput" FontSize="12" Padding="6,4"/>
                            <Button Content="Aplicar" FontSize="11" Margin="0,6,0,0"
                                    HorizontalAlignment="Right" Padding="10,3"
                                    Background="#4A90D9" Foreground="White" BorderThickness="0"
                                    Cursor="Hand" Click="ApplyTags_Click"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Popup de recordatorio -->
                <Popup x:Name="ReminderPopup"
                       PlacementTarget="{Binding ElementName=ReminderButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Background="White" CornerRadius="8"
                            BorderBrush="#DDD" BorderThickness="1" Padding="10">
                        <StackPanel Width="220">
                            <TextBlock Text="Recordatorio" FontSize="11"
                                       Foreground="#666" Margin="0,0,0,4"/>
                            <DatePicker x:Name="ReminderDatePicker" FontSize="12"/>
                            <TextBox x:Name="ReminderTimeInput" FontSize="12" Padding="6,4"
                                     Margin="0,4,0,0" ToolTip="Hora HH:mm"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button Content="Quitar" FontSize="11" Margin="0,0,6,0"
                                        Padding="8,3" Background="#F1F5F9" Foreground="#64748B"
                                        BorderThickness="0" Cursor="Hand" Click="ClearReminder_Click"/>
                                <Button Content="Fijar" FontSize="11"
                                        Padding="10,3" Background="#4A90D9" Foreground="White"
                                        BorderThickness="0" Cursor="Hand" Click="SetReminder_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Popup de emojis -->
                <Popup x:Name="EmojiPopup"
                       PlacementTarget="{Binding ElementName=EmojiButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Background="White" CornerRadius="8"
                            BorderBrush="#DDD" BorderThickness="1" Padding="8">
                        <ScrollViewer MaxHeight="180">
                            <WrapPanel x:Name="EmojiPanel" Width="216"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,5,0,0">
                    <Button x:Name="CancelEditButton" Content="✕ Cancelar"
                            Style="{StaticResource SaveButtonStyle}"
                            Background="#E2E8F0" Foreground="#64748B"
                            Margin="0,0,6,0"
                            ToolTip="Cancelar edición"
                            Click="CancelEditButton_Click"/>
                    <Button x:Name="SaveButton" Content="✓ Guardar"
                            Style="{StaticResource SaveButtonStyle}"
                            Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Resize handle (bottom-right) -->
            <Thumb x:Name="ResizeThumb" Grid.Row="2"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Width="16" Height="16" Cursor="SizeNWSE"
                   Margin="0,0,-2,-4"
                   DragDelta="ResizeThumb_DragDelta"
                   DragCompleted="ResizeThumb_DragCompleted">
                <Thumb.Template>
                    <ControlTemplate>
                        <Grid>
                            <Path Data="M-1,15 L15,-1 L15,15 Z"
                                  Fill="#00000020" Stroke="#00000030" StrokeThickness="0.5"/>
                            <Path Data="M3,15 L15,3 L15,15 Z"
                                  Fill="#00000010" Stroke="#00000020" StrokeThickness="0.5"/>
                            <Path Data="M7,15 L15,7 L15,15 Z"
                                  Fill="#00000008"/>
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</UserControl>
