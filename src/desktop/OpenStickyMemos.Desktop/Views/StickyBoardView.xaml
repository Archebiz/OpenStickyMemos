<UserControl x:Class="OpenStickyMemos.Desktop.Views.StickyBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OpenStickyMemos.Desktop.Views"
             mc:Ignorable="d"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <!-- ➕ Primary action button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#4A90D9" Offset="0"/>
                                    <GradientStop Color="#357ABD" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.25" Color="#4A90D9"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary (cancel) button -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 🔙 Back button style -->
        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,4,12,4"/>
            <Setter Property="Foreground" Value="{StaticResource BrandBlueBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#4A90D915"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ➕ Add note button style -->
        <Style x:Key="AddNoteButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#4A90D9" Offset="0"/>
                                    <GradientStop Color="#357ABD" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.25" Color="#4A90D9"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ⚪ Header secondary button style -->
        <Style x:Key="HeaderSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 🟡 Header alert/approvals button style -->
        <Style x:Key="HeaderAlertButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#854D0E"/>
            <Setter Property="Background" Value="#FEFCE8"/>
            <Setter Property="BorderBrush" Value="#FDE047"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FEF08A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="16,10,16,10"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.08" Color="#000"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="← Proyectos"
                        Style="{StaticResource BackButtonStyle}"
                        ToolTip="Volver a mis proyectos"
                        Click="BackButton_Click"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="📋" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ProjectName}"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="RenameProjectButton" Content="✏️"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Renombrar proyecto"
                            Click="RenameProjectButton_Click"
                            Visibility="Collapsed"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="TagFilterTextBox"
                             Width="180"
                             Height="32"
                             Margin="0,0,8,0"
                             Padding="10,4"
                             VerticalContentAlignment="Center"
                             FontSize="12"
                             FontFamily="Segoe UI"
                             BorderBrush="{StaticResource BorderLightBrush}"
                             BorderThickness="1"
                             Background="#F8FAFC"
                             ToolTip="🔍 Buscar en notas (título, contenido o etiqueta)"
                             TextChanged="TagFilterTextBox_TextChanged">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="7"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <Button x:Name="ApprovalsButton" Content="⏳ Solicitudes (0)"
                            Style="{StaticResource HeaderAlertButtonStyle}"
                            ToolTip="Solicitudes pendientes de aprobación"
                            Click="ApprovalsButton_Click"
                            Visibility="Collapsed"
                            Margin="0,0,8,0"/>
                    <Button x:Name="InviteButton" Content="👥 Compartir"
                            Style="{StaticResource HeaderSecondaryButtonStyle}"
                            Click="InviteButton_Click"
                            ToolTip="Gestionar miembros y enlaces de invitación"
                            Margin="0,0,8,0"/>
                    <Button x:Name="ArchiveFilterButton" Content="🗄️ Archivadas"
                            Style="{StaticResource HeaderSecondaryButtonStyle}"
                            ToolTip="Ver notas archivadas"
                            Click="ArchiveFilterButton_Click"
                            Margin="0,0,8,0"/>
                    <Button Content="＋ Nota"
                            Style="{StaticResource AddNoteButtonStyle}"
                            ToolTip="Crear nueva nota [o doble clic en el lienzo]"
                            Click="AddNote_Click"
                            Margin="0,0,8,0"/>
                    <Button x:Name="NotificationBellButton" Content="🔔"
                            Style="{StaticResource HeaderSecondaryButtonStyle}"
                            ToolTip="Notificaciones y menciones"
                            Click="NotificationBellButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Canvas with glassmorphism gradient background -->
        <Canvas Grid.Row="1" x:Name="NotesCanvas"
                ClipToBounds="True"
                MouseLeftButtonDown="Canvas_MouseDown"
                Background="{StaticResource BgGradientWarm}"/>

        <!-- Bottom hint and live connection status bar -->
        <Border Grid.Row="1" VerticalAlignment="Bottom"
                Background="#D9FFFFFF" Padding="14,6"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0"
                IsHitTestVisible="False">
            <Grid>
                <TextBlock Text="💡 Tip: Haz doble clic en cualquier parte del lienzo para crear una nota rápida"
                           FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Sincronizado en tiempo real" FontSize="11" Foreground="#059669" FontWeight="Medium"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Invitation dialog overlay -->
        <Border Grid.RowSpan="2" x:Name="InvitationOverlay"
                Background="#60000000"
                Visibility="Collapsed"
                Panel.ZIndex="100">
            <Border Width="500" Height="Auto" Padding="28"
                    Background="White" CornerRadius="14"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Effect="{StaticResource ShadowXl}">
                <StackPanel>
                    <TextBlock Text="Invitar miembros" FontSize="20"
                               FontWeight="SemiBold" Margin="0,0,0,4"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Compartí el link o invitá por email"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,16"/>

                    <!-- Tabs -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="EmailTabBtn" Content="Por email"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ShowEmailTab_Click" Margin="0,0,6,0"/>
                        <Button x:Name="LinkTabBtn" Content="Link de invitación"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ShowLinkTab_Click" Margin="0,0,6,0"/>
                        <Button x:Name="MembersTabBtn" Content="Miembros"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ShowMembersTab_Click"/>
                    </StackPanel>

                    <!-- Tab: Invitar por email -->
                    <StackPanel x:Name="EmailTabPanel" Visibility="Visible">
                        <TextBlock Text="Email del usuario" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,4"/>
                        <Border BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="1" CornerRadius="8" Margin="0,0,0,10">
                            <TextBox x:Name="InviteEmailInput"
                                     FontSize="14" Padding="12,10"
                                     BorderThickness="0"/>
                        </Border>
                        <Button Content="Invitar"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="InviteByEmail_Click"/>
                        <TextBlock x:Name="InviteEmailMessage"
                                   FontSize="12" Foreground="{StaticResource BrandBlueBrush}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Tab: Link de invitación -->
                    <StackPanel x:Name="LinkTabPanel" Visibility="Collapsed">
                        <TextBlock Text="Generá un link para compartir con cualquier persona."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <!-- Opciones del link -->
                        <Border Background="#F8FAFC" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox x:Name="RestrictEmailCheck"
                                          Content="Restringir a un email específico"
                                          FontSize="12"
                                          Checked="RestrictEmail_Checked"
                                          Unchecked="RestrictEmail_Unchecked"/>
                                <Border x:Name="RestrictEmailPanel" Visibility="Collapsed"
                                        BorderBrush="{StaticResource BorderLightBrush}"
                                        BorderThickness="1" CornerRadius="8" Margin="0,8,0,0">
                                    <TextBox x:Name="InviteLinkEmailInput"
                                             FontSize="13" Padding="10,8"
                                             BorderThickness="0"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Vence en:" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="ExpiresDaysCombo"
                                              FontSize="12" Width="120">
                                        <ComboBoxItem Content="1 día" Tag="1"/>
                                        <ComboBoxItem Content="3 días" Tag="3" IsSelected="True"/>
                                        <ComboBoxItem Content="7 días" Tag="7"/>
                                        <ComboBoxItem Content="14 días" Tag="14"/>
                                        <ComboBoxItem Content="30 días" Tag="30"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button x:Name="GenerateLinkBtn"
                                Content="🔗 Generar link"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="GenerateInvitationLink_Click"/>
                        <TextBlock x:Name="InvitationLinkError"
                                   FontSize="12" Foreground="#DC2626"
                                   Margin="0,6,0,0"/>

                        <!-- Lista de links activos -->
                        <StackPanel x:Name="ActiveLinksPanel" Visibility="Collapsed" Margin="0,16,0,0">
                            <TextBlock x:Name="ActiveLinksTitle"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,8"/>
                            <ScrollViewer MaxHeight="200">
                                <ItemsControl x:Name="ActiveLinksList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderLightBrush}"
                                                    BorderThickness="0,0,0,1" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding InvitationLink}"
                                                                   FontSize="11" Foreground="{StaticResource BrandBlueBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding InvitedEmail, StringFormat='📧 {0}'}"
                                                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                                                       Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding ExpiresAt, StringFormat='⏳ Vence {0:g}'}"
                                                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Content="📋" FontSize="14"
                                                                BorderThickness="0" Background="Transparent"
                                                                Cursor="Hand" Margin="0,0,4,0"
                                                                Click="CopyLink_Click"/>
                                                        <Button Content="🗑️" FontSize="14"
                                                                BorderThickness="0" Background="Transparent"
                                                                Cursor="Hand"
                                                                Click="RevokeInvitation_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>

                    <!-- Tab: Miembros -->
                    <StackPanel x:Name="MembersTabPanel" Visibility="Collapsed">
                        <TextBlock x:Name="MembersTitle"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,8"/>
                        <ScrollViewer MaxHeight="250">
                            <ItemsControl x:Name="MembersList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderLightBrush}"
                                                BorderThickness="0,0,0,1" Padding="8,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Email}"
                                                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Border Background="#EDF2F7" CornerRadius="10"
                                                            Padding="8,2,8,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Role}"
                                                                   FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </Border>
                                                    <Button Content="✕" FontSize="14"
                                                            BorderThickness="0" Background="Transparent"
                                                            Cursor="Hand" Margin="8,0,0,0"
                                                            Click="RemoveMember_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Close button -->
                    <Button Content="Cerrar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CloseInvitationDialog_Click"
                            Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Sidebar para mover notas a otro proyecto (visible al arrastrar) -->
        <Border Grid.RowSpan="2" x:Name="MoveSidebarOverlay"
                HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Width="260"
                Background="#F4F7FB"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1,0,0,0"
                Visibility="Collapsed"
                Panel.ZIndex="90">
            <StackPanel>
                <TextBlock Text="📋 Mover nota a..." FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="16,16,16,4"/>
                <TextBlock Text="Soltá la nota sobre un proyecto para moverla" FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap" Margin="16,0,16,12"/>
                <StackPanel x:Name="MoveProjectPanel"/>
            </StackPanel>
        </Border>

        <!-- Diálogo de renombrar proyecto -->
        <Border Grid.RowSpan="2" x:Name="RenameOverlay"
                Background="#60000000"
                Visibility="Collapsed"
                Panel.ZIndex="100">
            <Border Width="400" Padding="24"
                    Background="White" CornerRadius="14"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Effect="{StaticResource ShadowXl}">
                <StackPanel>
                    <TextBlock Text="Renombrar proyecto" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Escribí el nuevo nombre del proyecto" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>
                    <Border BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                        <TextBox x:Name="RenameProjectInput"
                                 FontSize="14" Padding="12,10"
                                 BorderThickness="0"
                                 KeyDown="RenameProjectInput_KeyDown"/>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CloseRename_Click"/>
                        <Button Grid.Column="2" Content="Guardar"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="SaveRename_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Panel de solicitudes de aprobación (owner) -->
        <Border Grid.RowSpan="2" x:Name="ApprovalsOverlay"
                Background="#60000000"
                Visibility="Collapsed"
                Panel.ZIndex="100">
            <Border Width="480" MaxHeight="540" Padding="24"
                    Background="White" CornerRadius="14"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Effect="{StaticResource ShadowXl}">
                <StackPanel>
                    <TextBlock x:Name="ApprovalsTitle" Text="Solicitudes pendientes"
                               FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Un miembro solicitó archivar o eliminar una nota. Aprobá o rechazá cada solicitud."
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <ScrollViewer MaxHeight="300" Margin="0,12,0,0">
                        <ItemsControl x:Name="ApprovalsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#EEF1F5" BorderThickness="0,0,0,1" Padding="6,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                                                    Background="{Binding NoteColor}" Margin="0,0,10,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="📝" FontSize="17"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NoteTitle}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="11" Foreground="#7A8794">
                                                    <Run Text="{Binding RequesterName}"/>
                                                    <Run Text=" solicitó "/>
                                                    <Run Text="{Binding TypeDisplay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="✓" Width="30" Height="30" Margin="0,0,6,0"
                                                        FontSize="14" FontWeight="Bold"
                                                        Background="#22C55E" Foreground="White"
                                                        BorderThickness="0" Cursor="Hand"
                                                        ToolTip="Aprobar" Tag="{Binding Id}"
                                                        Click="ApproveRequest_Click"/>
                                                <Button Content="✕" Width="30" Height="30"
                                                        FontSize="14" FontWeight="Bold"
                                                        Background="#EF4444" Foreground="White"
                                                        BorderThickness="0" Cursor="Hand"
                                                        ToolTip="Rechazar" Tag="{Binding Id}"
                                                        Click="RejectRequest_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Content="Cerrar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CloseApprovals_Click"
                            Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Panel de Notificaciones y Menciones -->
        <Border Grid.RowSpan="2" x:Name="NotificationsOverlay"
                Background="#60000000"
                Visibility="Collapsed"
                Panel.ZIndex="110">
            <Border Width="480" MaxHeight="540" Padding="24"
                    Background="White" CornerRadius="14"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Effect="{StaticResource ShadowXl}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Notificaciones y menciones"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Content="Marcar todas como leídas"
                                Style="{StaticResource HeaderSecondaryButtonStyle}"
                                HorizontalAlignment="Right"
                                Padding="8,4" FontSize="11"
                                Click="MarkAllNotificationsRead_Click"/>
                    </Grid>
                    <TextBlock x:Name="NotificationsEmptyText"
                               Text="No tienes notificaciones pendientes 🎉"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,30,0,30"
                               Visibility="Collapsed"/>
                    <ScrollViewer MaxHeight="320" Margin="0,8,0,0">
                        <ItemsControl x:Name="NotificationsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#EEF1F5" BorderThickness="0,0,0,1" Padding="8,10"
                                            Background="White" Cursor="Hand" Tag="{Binding}"
                                            MouseLeftButtonUp="NotificationItem_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                                    Background="#EEF2FF" Margin="0,0,10,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="🔔" FontSize="16"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap">
                                                    <Bold><Run Text="{Binding AuthorName}"/></Bold>
                                                    <Run Text=" te mencionó en "/>
                                                    <Run Text="{Binding NoteTitle, TargetNullValue='una nota'}" Foreground="#4F46E5" FontWeight="SemiBold"/>
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="4,1" Margin="0,0,8,0">
                                                        <TextBlock FontSize="10" Foreground="#475569">
                                                            <Run Text="📁 "/><Run Text="{Binding ProjectName}"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:g}'}"
                                                               FontSize="10" Foreground="#94A3B8"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Ellipse Grid.Column="2" Width="8" Height="8" Fill="#10B981"
                                                     VerticalAlignment="Center" Margin="6,0,0,0"
                                                     Visibility="{Binding IsRead, Converter={StaticResource InvertBoolToVis}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Content="Cerrar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CloseNotifications_Click"
                            Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
